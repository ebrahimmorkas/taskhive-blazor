<MudPaper Elevation="1" Class="@($"task-card pa-3 mb-2 priority-{Card.Priority.ToString().ToLowerInvariant()}")" @onclick="() => OnOpen.InvokeAsync(Card)">
    <div class="d-flex justify-space-between align-center mb-1">
        <MudText Typo="Typo.caption" Class="task-key">@Card.Key</MudText>
        <PriorityChip Priority="Card.Priority" />
    </div>
    <MudText Typo="Typo.body2" Class="task-title">@Card.Title</MudText>
    <div class="d-flex justify-space-between align-center mt-2">
        @if (Card.DueDate is { } due)
        {
            <MudText Typo="Typo.caption" Color="@(IsOverdue ? Color.Error : Color.Default)" Class="d-flex align-center gap-1 due-date">
                <MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />
                @(IsOverdue ? "Overdue · " : string.Empty)@due.ToString("d MMM")
            </MudText>
        }
        else
        {
            <span></span>
        }
        @if (Card.AssigneeName is not null)
        {
            <UserAvatar Name="@Card.AssigneeName" />
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public TaskCardView Card { get; set; } = null!;

    [Parameter]
    public EventCallback<TaskCardView> OnOpen { get; set; }

    [Parameter]
    public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);

    private bool IsOverdue => Card.DueDate is { } due && due < Today;
}
