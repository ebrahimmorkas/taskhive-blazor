@inject CollaborationService Collaboration
@inject CurrentUser CurrentUser
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Existing is null ? "New task" : Existing.Key)</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="_title" Label="Title" Required="true" RequiredError="A task needs a title"
                          MaxLength="200" Variant="Variant.Outlined" AutoFocus="true" Immediate="true" />
            <MudTextField @bind-Value="_description" Label="Description" Lines="4" MaxLength="4000"
                          Variant="Variant.Outlined" Class="mt-3" />
            <div class="d-flex gap-3 mt-3 flex-wrap">
                <MudSelect T="TaskPriority" @bind-Value="_priority" Label="Priority" Variant="Variant.Outlined" Style="min-width: 150px">
                    @foreach (var priority in Enum.GetValues<TaskPriority>())
                    {
                        <MudSelectItem Value="priority">@priority</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_assigneeId" Label="Assignee" Variant="Variant.Outlined" Clearable="true" Style="min-width: 200px">
                    @foreach (var member in Members)
                    {
                        <MudSelectItem Value="member.UserId">@member.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker @bind-Date="_dueDate" Label="Due date" Variant="Variant.Outlined" Clearable="true" Style="max-width: 200px" />
            </div>
        </MudForm>

        @if (Existing is not null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Comments (@_comments.Count)</MudText>
            <div class="comments">
                @foreach (var comment in _comments)
                {
                    <div class="d-flex gap-2 mb-3">
                        <UserAvatar Name="@comment.AuthorName" />
                        <div>
                            <MudText Typo="Typo.body2"><b>@comment.AuthorName</b> <span class="mud-text-secondary">@comment.CreatedAtUtc.ToLocalTime().ToString("d MMM, HH:mm")</span></MudText>
                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap">@comment.Body</MudText>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 align-end">
                <MudTextField @bind-Value="_newComment" Placeholder="Write a comment…" Lines="2" Variant="Variant.Outlined"
                              MaxLength="@CollaborationService.MaxCommentLength" Immediate="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" aria-label="Post comment"
                               Disabled="@string.IsNullOrWhiteSpace(_newComment)" OnClick="PostCommentAsync" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (Existing is not null)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Delete" OnClick="Delete" Class="mr-auto">Delete</MudButton>
        }
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="!_isValid" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Returned when the user chose to delete the task.</summary>
    public const string DeleteRequested = "delete";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public TaskCardView? Existing { get; set; }

    [Parameter]
    public IReadOnlyList<MemberOption> Members { get; set; } = [];

    private MudForm? _form;
    private bool _isValid;
    private string _title = string.Empty;
    private string? _description;
    private TaskPriority _priority = TaskPriority.Medium;
    private string? _assigneeId;
    private DateTime? _dueDate;
    private IReadOnlyList<CommentView> _comments = [];
    private string? _newComment;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Existing is null)
        {
            return;
        }

        _title = Existing.Title;
        _description = Existing.Description;
        _priority = Existing.Priority;
        _assigneeId = Existing.AssigneeId;
        _dueDate = Existing.DueDate?.ToDateTime(TimeOnly.MinValue);

        _userId = await CurrentUser.GetIdAsync();
        var comments = await Collaboration.GetCommentsAsync(_userId, Existing.Id);
        _comments = comments.IsSuccess ? comments.Value : [];
    }

    private async Task PostCommentAsync()
    {
        var result = await Collaboration.AddCommentAsync(_userId, Existing!.Id, _newComment!);
        if (result.IsFailure)
        {
            Snackbar.Add(result.Error!.Message, Severity.Warning);
            return;
        }

        _comments = [.. _comments, result.Value];
        _newComment = null;
    }

    private void Save() => MudDialog.Close(DialogResult.Ok(new TaskInput(
        _title,
        string.IsNullOrWhiteSpace(_description) ? null : _description,
        _priority,
        _assigneeId,
        _dueDate is { } date ? DateOnly.FromDateTime(date) : null)));

    private void Delete() => MudDialog.Close(DialogResult.Ok(DeleteRequested));
}
