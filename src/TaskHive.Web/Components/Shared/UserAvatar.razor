<MudTooltip Text="@Name">
    <MudAvatar Size="@Size" Style="@($"background-color: {ColorFor(Name)}; color: white;")">@Initials</MudAvatar>
</MudTooltip>

@code {
    private static readonly string[] Palette = ["#6d28d9", "#0891b2", "#16a34a", "#ea580c", "#db2777", "#4f46e5", "#ca8a04"];

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public Size Size { get; set; } = Size.Small;

    private string Initials =>
        string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    // Stable colour per person so teammates are recognisable across the board.
    private static string ColorFor(string name) =>
        Palette[(int)((uint)name.Aggregate(17, (hash, c) => hash * 31 + c) % Palette.Length)];
}
