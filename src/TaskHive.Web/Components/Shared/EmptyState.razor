<MudPaper Elevation="0" Outlined="true" Class="pa-10 d-flex flex-column align-center text-center">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h6" Class="mt-3">@Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Message</MudText>
    @ChildContent
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
