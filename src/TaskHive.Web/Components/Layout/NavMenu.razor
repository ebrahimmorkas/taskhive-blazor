@implements IDisposable
@inject NavigationManager NavigationManager
@inject WorkspaceService WorkspaceService
@inject CurrentUser CurrentUser

<MudNavMenu Class="pt-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-4 mt-4 d-block">Workspaces</MudText>
            @foreach (var workspace in _workspaces)
            {
                <MudNavGroup Title="@workspace.Name" Icon="@Icons.Material.Filled.Workspaces" Expanded="@IsCurrent(workspace)">
                    <MudNavLink Href="@($"w/{workspace.Slug}")" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewKanban">Projects</MudNavLink>
                    <MudNavLink Href="@($"w/{workspace.Slug}/members")" Icon="@Icons.Material.Filled.People">Members</MudNavLink>
                </MudNavGroup>
            }
            <MudNavLink Href="/workspaces/new" Icon="@Icons.Material.Filled.Add">New workspace</MudNavLink>

            <MudDivider Class="my-4" />
            <MudNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.ManageAccounts">Account</MudNavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Logout" FullWidth="true" Class="justify-start px-4">
                    Sign out
                </MudButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Icon="@Icons.Material.Filled.PersonAdd">Register</MudNavLink>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">Sign in</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<WorkspaceSummary> _workspaces = [];
    private string? _currentUrl;

    protected override async Task OnInitializedAsync()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        await LoadWorkspacesAsync();
    }

    private async Task LoadWorkspacesAsync()
    {
        if (AuthenticationState is null || (await AuthenticationState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _workspaces = await WorkspaceService.GetForUserAsync(await CurrentUser.GetIdAsync());
    }

    private bool IsCurrent(WorkspaceSummary workspace) =>
        _currentUrl?.StartsWith($"w/{workspace.Slug}", StringComparison.OrdinalIgnoreCase) == true;

    // Reload on navigation so newly created or joined workspaces appear without a full page refresh.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        await LoadWorkspacesAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
